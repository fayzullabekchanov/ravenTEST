# PostgreSQL connection string
# Example (local): postgresql://postgres:postgres@localhost:5432/raven_test
# Example (hosted, e.g. Neon/Supabase/Railway): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raven_test"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
