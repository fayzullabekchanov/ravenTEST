# PostgreSQL ulanish manzili (docker-compose ishlatilsa quyidagicha bo'ladi)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/raven_test"

# Sessiya (JWT) imzolash uchun kamida 32 belgili tasodifiy maxfiy kalit.
# Masalan: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-plus-character-secret"

# `npm run db:seed` orqali yaratiladigan admin akkaunti
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisSecurePassword123!"
